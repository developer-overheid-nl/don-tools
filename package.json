{
  "name": "@developer-overheid-nl/don-tools",
  "version": "0.0.2",
  "description": "Business logic for the developer.overheid.nl Tools API and future CLI",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22",
    "pnpm": ">=11"
  },
  "packageManager": "pnpm@11.22.0+sha512.1ff870c4c6133dfd88fb2afc46dd13d47f09c9794b438c6fdb47ca98caf3bc16381ee0be93a091b8e3824cf01f889f46d7d9e20910fb0be1ab0fb5baa80dd621",
  "scripts": {
    "prepare": "npm run build",
    "prebuild": "rm -rf dist",
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "openapi",
    "developer-overheid"
  ],
  "license": "EUPL-1.2",
  "private": false,
  "dependencies": {
    "@apiture/openapi-down-convert": "^0.14.2",
    "@developer-overheid-nl/adr-rulesets": "github:developer-overheid-nl/adr-rulesets#main",
    "@redocly/openapi-core": "^2.54.3",
    "@redocly/respect-core": "^2.54.3",
    "@scalar/openapi-upgrader": "^0.4.0",
    "@stoplight/spectral-core": "^1.23.1",
    "@stoplight/spectral-parsers": "^1.0.5",
    "case-anything": "^3.1.6",
    "js-yaml": "^5.4.2",
    "jszip": "^3.10.2",
    "openapi-to-postmanv2": "^6.3.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "pg": "^8.23.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "peerDependencies": {
    "pg": "^8.23.0"
  },
  "peerDependenciesMeta": {
    "pg": {
      "optional": true
    }
  }
}
